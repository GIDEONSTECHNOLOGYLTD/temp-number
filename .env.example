# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Secret (CHANGE THIS IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Database
MONGODB_URI=mongodb://localhost:27017/tempsms

# SMS API Configuration (5SIM.net)
SMS_API_KEY=your-5sim-api-key-here
SMS_API_URL=https://5sim.net/v1

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# CORS Settings
CORS_ORIGIN=*

# App URL (used in email links)
APP_URL=http://localhost:3000

# Email (nodemailer - use Gmail App Password or SMTP relay)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Paystack (https://paystack.com)
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key

# NOWPayments - Crypto (https://nowpayments.io)
NOWPAYMENTS_API_KEY=your_nowpayments_api_key
NOWPAYMENTS_IPN_SECRET=your_nowpayments_ipn_secret

# Logging
LOG_LEVEL=info
